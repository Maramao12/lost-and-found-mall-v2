{
  "info": {
    "name": "Lost & Found – Binôme 1 : Utilisateurs & Sécurité",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lancez le backend (npm run dev) puis exécutez les dossiers dans l'ordre (Collection Runner), ou requête par requête."
  },
  "item": [
    {
      "name": "1 - Authentification",
