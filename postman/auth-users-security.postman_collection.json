              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Créez d'abord l'admin : npm run create-user -- admin@lostfound.tn Admin12345 ADMIN BenAli Karim",
            "auth": {
              "type": "noauth"
