        {
          "name": "1. Inscription (membre)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailMembre\", \"membre.\" + Date.now() + \"@mail.tn\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Rôle MEMBRE et pas de hash\", function () { pm.expect(j.data.user.role).to.eql(\"MEMBRE\"); pm.expect(j.data.user).to.not.have.property(\"motDePasseHash\"); });",
                  "pm.collectionVariables.set(\"tokenMembre\", j.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Trabelsi\",\n  \"prenom\": \"Islem\",\n  \"email\": \"{{emailMembre}}\",\n  \"motDePasse\": \"{{mdpMembre}}\",\n  \"telephone\": \"22 333 444\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
