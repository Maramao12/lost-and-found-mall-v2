    {
      "name": "3 - Administration (ADMIN)",
      "item": [
        {
          "name": "1. Connexion admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Rôle ADMIN\", function () { pm.expect(j.data.user.role).to.eql(\"ADMIN\"); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", j.data.token);",
                  "pm.collectionVariables.set(\"adminId\", j.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
