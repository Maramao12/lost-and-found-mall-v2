# ============================================================
# MODÈLE DE CONFIGURATION (ce fichier EST commité sur GitHub)
# Copiez-le en ".env" (qui, lui, n'est JAMAIS commité) :
#   Windows : copy .env.example .env
# puis remplacez les valeurs si besoin.
# ============================================================

# Adresse de MongoDB (Compass local) + nom de la base
MONGODB_URI=mongodb://127.0.0.1:27017/lostfound

# Clé secrète pour signer les jetons JWT (mettez une longue phrase aléatoire)
JWT_SECRET=changez_moi_par_une_longue_phrase_secrete

# Durée de validité d'un jeton JWT
JWT_EXPIRES_IN=1d

# Port du serveur Express
PORT=5000
